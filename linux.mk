OBJS=$(patsubst %,build/obj/%.o,$(SRC))
all: Src/Inc/build_timestamp.h
	$(MAKE) -f linux.mk build/F7Discovery.bin

Src/Inc/build_timestamp.h: FORCE
	@printf '#ifndef BUILD_TIMESTAMP\n#define HGREV %s\n#define BUILD_TIMESTAMP_US "%s UT"\n#define BUILD_TIMESTAMP_D "%s UT"\n#define HGREVSTR(s) stringify_(s)\n#define stringify_(s) #s\n#endif\n' "$$(git rev-parse --short=8 HEAD 2>/dev/null || echo 0)" "$$(date -u '+%Y-%m-%d %H:%M')" "$$(date -u '+%d-%m-%Y %H:%M')" > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@; rm -f $@.tmp
FORCE:

build/F7Discovery.bin: build/F7Discovery.elf
	$(OBJCOPY) -O binary $< $@
	$(SIZE) $<
build/F7Discovery.elf: $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)
build/obj/%.o: %
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) $(DEFS) $(INC) -c $< -o $@
-include $(OBJS:.o=.d)

clean:
	rm -rf build
.PHONY: all clean FORCE
