# Linux / macOS build for the EU1KY AA v3 (DH1AKF & KD8CEC mod, LZ1RVD fixes)
# Equivalent to the EmBitz project F7Discovery.ebp (same sources, defines, flags).
#
# Requirements: arm-none-eabi-gcc (tested with xPack GCC 13.3.1) in PATH, make, git.
# Usage:        make -f linux.mk -j8
# Output:       build/F7Discovery.bin  -> copy to the DIS_F746NG drive of the board
#
# The Windows build (EmBitz / Makefile + gen_timestamp.bat) is unchanged.

CC=arm-none-eabi-gcc
OBJCOPY=arm-none-eabi-objcopy
SIZE=arm-none-eabi-size
ARCH=-mcpu=cortex-m7 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16
CFLAGS=$(ARCH) -fgcse -fexpensive-optimizations -fomit-frame-pointer -fdata-sections -ffunction-sections -Os -g -flto -MMD -std=gnu99 -fcommon -Wall -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-misleading-indentation
DEFS=-DSTM32F746xx -DSTM32F746G_DISCO -DSTM32F746NGHx -DSTM32F7 -DSTM32 -DUSE_HAL_DRIVER -DARM_MATH_CM7 -D__FPU_PRESENT -DUSE_USB_HS -DLODEPNG_NO_COMPILE_DISK -DLODEPNG_NO_COMPILE_ERROR_TEXT -DLODEPNG_NO_COMPILE_ALLOCATORS -DLODEPNG_NO_COMPILE_ANCILLARY_CHUNKS -DLODEPNG_NO_COMPILE_DECODER
INC=-ISrc/BSP/Components/Common -ISrc/BSP/Components/ampire480272 -ISrc/BSP/Components/ampire640480 -ISrc/BSP/Components/exc7200 -ISrc/BSP/Components/ft5336 -ISrc/BSP/Components/mfxstm32l152 -ISrc/BSP/Components/n25q128a -ISrc/BSP/Components/n25q512a -ISrc/BSP/Components/ov9655 -ISrc/BSP/Components/rk043fn48h -ISrc/BSP/Components/s5k5cag -ISrc/BSP/Components/stmpe811 -ISrc/BSP/Components/ts3510 -ISrc/BSP/Components/wm8994 -ISrc/BSP/STM32746G-Discovery -ISrc/CMSIS/Device/ST/STM32F7xx/Include -ISrc/CMSIS/Include -ISrc/CMSIS/RTOS/Template -ISrc/Inc -ISrc/STM32F7xx_HAL_Driver/Inc -ISrc/STM32F7xx_HAL_Driver/Inc/Legacy -ISrc/USBD -ISrc/analyzer/adc -ISrc/analyzer/config -ISrc/analyzer/digital -ISrc/analyzer/dsp -ISrc/analyzer/fftfilters -ISrc/analyzer/gen -ISrc/analyzer/gpio -ISrc/analyzer/lcd -ISrc/analyzer/lcd/bitmaps -ISrc/analyzer/osl -ISrc/analyzer/rtc -ISrc/analyzer/uartcomm -ISrc/analyzer/window -ISrc/fatfs -ISrc/fatfs/drivers
LDFLAGS=$(CFLAGS) -u _printf_float -specs=nano.specs -specs=nosys.specs -Wl,--gc-sections -Wl,-Map=build/F7Discovery.map -TSrc/Sys/STM32F746NGHx_FLASH.ld -lm
